# Slanje upita sa kontakt forme (app/api/lead/route.ts).
# Bez ovih promenljivih ruta namerno vraca gresku 503 i broj telefona,
# umesto da prikaze "hvala" za upit koji nigde nije stigao.
#
# !!! OVAJ FAJL IDE U JAVNI GIT. LOZINKA OVDE NE SME. !!!
# Prave vrednosti stoje u .env.local (git ga ne prati) i u podesavanjima
# projekta na Vercelu. Commit sa popunjenim SMTP_PASS odbija kuka u
# .githooks/pre-commit.
# Posta je na Titanu, ne na Hostingerovom serveru: MX zapisi za
# popzify.com pokazuju na mx1.titan.email.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=business@popzify.com
SMTP_PASS=

# Gde stizu upiti. Podrazumevano business@popzify.com.
LEAD_TO=business@popzify.com

# Meta piksel na kampanjskim stranama (/marketing, /reels, /svadbe).
# Bez ovoga se piksel uopste ne ubacuje, nijedan poziv ne ide ka Meti,
# a odeljak o njemu u politici privatnosti se ne prikazuje.
NEXT_PUBLIC_META_PIKSEL_ID=
