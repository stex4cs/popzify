# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sirovi snimci ekrana i eksporti, ne idu u repo. Samo u korenu
# projekta: ranije je ovde stajalo *.mp4, pa je pravilo progutalo i
# snimke u public/ — na sajtu nijedan video nije radio, a lokalno jeste.
/*.mp4
/*.mov

# sirovi materijal iz kamere i drona; u repo ide samo web verzija iz public/.
# Pravilo je usidreno na koren: neusidreno `assets/` hvata svaku fasciklu tog
# imena, pa je gutalo i public/igra/assets/ - isti promasaj kao nekadasnje *.mp4.
/assets/

# privremeni Chrome profil iz rasterizacije ikone
*.prof/

# Izvorni dizajn fajlovi (PNG/JPG, 23 MB). Na sajt ide samo webp iz
# public/design/, napravljen iz ovih.
public/DIZAJN/
